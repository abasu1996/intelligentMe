from sklearn import datasets
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor


data_house = datasets.fetch_california_housing()


data_house_df = pd.DataFrame(data_house["data"],columns=data_house.feature_names)
data_house_df.head()


data_house_df[:5]


data_house



data_house_df.shape


data_house_df["target"] = pd.DataFrame(data_house["target"],columns=data_house.target_names)


data_house_df.head()


data_house_df.head()


X = data_house_df.drop(columns=["target"])
X.head()


y = data_house_df["target"]
y.head()


y.shape


X_train, X_test, y_train, y_test = train_test_split(X,y,test_size=0.3,random_state=42)


clf = DecisionTreeRegressor()

clf.fit(X_train,y_train)

score = clf.score(X_test,y_test)

print(f"Test Model Score :{score}")



